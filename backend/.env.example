PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=caps_app
DB_PASSWORD=
DB_NAME=caps_turnos
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
# Dirección del sistema que va en los mails (recuperar clave, confirmar turno).
# En desarrollo: http://localhost:5173 · Instalado (un solo proceso): http://localhost:3001
FRONTEND_URL=http://localhost:5173
# Mail real (opcional): sin esto, los mails se imprimen en la consola del backend.
# Con Gmail: cuenta dedicada + verificación en 2 pasos + "contraseña de aplicación" (16 letras, va en SMTP_PASS)
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=lacuenta@gmail.com  MAIL_FROM=CAPS Turnos <lacuenta@gmail.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Recordatorios: cuántas horas antes del turno se avisa (24 si no se pone). RECORDATORIOS=off los apaga.
# RECORDATORIO_HORAS=24
# RECORDATORIOS=off
# Ruta de mysqldump para las copias de seguridad (si XAMPP no está en C:\xampp)
# MYSQLDUMP=C:\xampp\mysql\bin\mysqldump.exe
